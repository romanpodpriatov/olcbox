<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The launchd daemon, registered by the app through SMAppService.daemon.

  BundleProgram, not Program: the path is relative to the app bundle, and that is
  what makes the daemon leave with the app when it is dragged to the Trash rather
  than outliving it in /Library. A daemon that survives the uninstall of the only
  thing that talks to it is a support burden with root privileges.

  AssociatedBundleIdentifiers is what puts the app's name on the row the user
  approves in Login Items. Without it macOS names the label instead, and a person
  asked to approve "org.olcbox.app.desktopApp.tunneld" has been told nothing.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.olcbox.app.desktopApp.tunneld</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/ProofKitTunnelDaemon</string>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>org.olcbox.app.desktopApp</string>
    </array>
</dict>
</plist>
