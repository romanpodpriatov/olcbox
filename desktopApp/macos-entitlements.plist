<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the hardened runtime, which notarisation requires.

  Without the first two a JVM app does not start under the hardened runtime at
  all — the JIT writes and then executes memory, and hardened runtime forbids
  that by default. The third is needed because the bundle loads JNI libraries and
  runs the sing-box / Xray binaries we ship beside it; library validation would
  refuse anything not signed by the same team, which includes them until they are
  signed in the same pass.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The app talks to the network and runs helper processes; both are its
         whole purpose, so they are declared rather than discovered at runtime. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
