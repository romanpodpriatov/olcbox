<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PreferenceSpecifiers</key>
    <array>
        <dict>
            <key>Type</key><string>PSGroupSpecifier</string>
            <key>Title</key><string>olcRTC / Telemost</string>
            <key>FooterText</key>
            <string>Allow IPv6 alongside IPv4 for olcRTC connections. Turn off to test IPv4 only. Networks that require IPv6 need this enabled. Disconnect and reconnect after changing.</string>
        </dict>
        <dict>
            <key>Type</key><string>PSToggleSwitchSpecifier</string>
            <key>Title</key><string>Allow IPv6</string>
            <key>Key</key><string>olcrtcAllowIPv6</string>
            <key>DefaultValue</key><true/>
        </dict>
    </array>
</dict>
</plist>
