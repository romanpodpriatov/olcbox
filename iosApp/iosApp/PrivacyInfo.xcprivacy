<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Apple's privacy manifest. Required since spring 2024, and its absence is
		not a silent omission: an upload that uses a "required reason" API
		without declaring it comes back as ITMS-91053, by email, after the build
		has already been processed.

		This app uses exactly one of them — NSUserDefaults, for the SOCKS
		credentials and the update-check bookkeeping — and collects nothing.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
		Empty on purpose, and true. Locations, subscriptions and logs stay on the
		device; the coordinator is asked to resolve a partner link and nothing
		about the person asking is sent with it.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: read and write only this app's own defaults. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
